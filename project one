-- ============================================
-- 3. ระบบ Aimbot & FOV Logic
-- ============================================
local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = Config.FOVSize

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(Config.AimPart) and player.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            local targetPart = player.Character[Config.AimPart]
            local screenPosition, onScreen = Camera:WorldToViewportPoint(targetPart.Position)

            if onScreen then
                local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                local distance = (Vector2.new(screenPosition.X, screenPosition.Y) - mousePos).Magnitude

                if distance < shortestDistance then
                    closestPlayer = targetPart
                    shortestDistance = distance
                end
            end
        end
    end
    return closestPlayer
end

-- Render Loop สำหรับ Aimbot และ FOV Circle
RunService.RenderStepped:Connect(function()
    -- อัปเดต FOV Circle
    FOVCircle.Radius = Config.FOVSize
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Visible = Config.FOVVisible and Config.AimbotEnabled

    -- ทำงาน Aimbot
    if Config.AimbotEnabled then
        local target = getClosestPlayer()
        if target then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
        end
    end
end)

-- ============================================
-- 4. ระบบ ESP (Box + Name)
-- ============================================
local espHolders = {}

local function createESP(player)
    if player == LocalPlayer then return end
    
    local function updateESP()
        local character = player.Character
        if not character then return end
        
        -- ใช้ Highlight สำหรับสร้าง ESP Box เรียบง่าย
        local highlight = character:FindFirstChild("ESPHighlight") or Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight.Parent = character
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.FillColor = Color3.fromRGB(255, 0, 0)
        highlight.Enabled = Config.ESPEnabled

        -- ESP Name
        local head = character:FindFirstChild("Head")
        if head then
            local billboard = head:FindFirstChild("ESPName") or Instance.new("BillboardGui")
            billboard.Name = "ESPName"
            billboard.Parent = head
            billboard.AlwaysOnTop = true
            billboard.Size = UDim2.new(0, 100, 0, 30)
            billboard.StudsOffset = Vector3.new(0, 2, 0)
            billboard.Enabled = Config.ESPName and Config.ESPEnabled

            local textLabel = billboard:FindFirstChildOfClass("TextLabel") or Instance.new("TextLabel")
            textLabel.Parent = billboard
            textLabel.Size = UDim2.new(1, 0, 1, 0)
            textLabel.BackgroundTransparency = 1
            textLabel.Text = player.Name
            textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            textLabel.TextScaled = true
        end
    end

    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        updateESP()
    end)
    updateESP()
end

-- เพิ่ม ESP ให้ผู้เล่นทุกคน
for _, p in pairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)

-- ============================================
-- 5. ระบบ Fly & Movement
-- ============================================
local bodyVelocity, bodyGyro

local function startFly()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = char.HumanoidRootPart
    bodyVelocity = Instance.new("BodyVelocity", hrp)
    bodyVelocity.MaxForce = Vector3.new(4e5, 4e5, 4e5)
    bodyVelocity.Velocity = Vector3.zero
    
    bodyGyro = Instance.new("BodyGyro", hrp)
    bodyGyro.MaxTorque = Vector3.new(4e5, 4e5, 4e5)
    bodyGyro.CFrame = hrp.CFrame

    task.spawn(function()
        while Config.FlyEnabled and char and hrp do
            bodyGyro.CFrame = Camera.CFrame
            bodyVelocity.Velocity = Camera.CFrame.LookVector * Config.FlySpeed
            task.wait()
        end
        if bodyVelocity then bodyVelocity:Destroy() end
        if bodyGyro then bodyGyro:Destroy() end
    end)
end

